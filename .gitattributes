# Program hashes must not depend on a checkout's core.autocrlf setting.
scripts/embedded-vim/*.js text eol=lf
scripts/embedded-vim/*.json text eol=lf
internal/embeddedvim/assets/manifest.json text eol=lf
internal/embeddedvim/assets/guest.js text eol=lf -whitespace linguist-generated=true
# Preserve upstream notices byte-for-byte, including their original formatting.
internal/embeddedvim/assets/licenses/* -text -whitespace linguist-vendored=true
internal/embeddedvim/assets/qjs.wasm binary
